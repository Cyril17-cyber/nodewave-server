PORT=3001
# Number of reverse proxies in front of the API (0 locally, usually 1 in production)
TRUST_PROXY=0

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=nodewave
# true for hosted databases (Supabase). DATABASE_SSL_CA = the server's CA certificate (PEM,
# newlines may be written as \n) so its identity is verified, not just encrypted.
DATABASE_SSL=false
DATABASE_SSL_CA=

# At least 32 random characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
SALTROUNDS=12

# Web app URL (used in email links) and browser origins allowed to call the API
CLIENTURL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

MAILHOST=
MAILPORT=587
MAILUSER=
MAILPASS=
MAIL_FROM="Nodewave <no-reply@nodewave.com>"

# Comma-separated Google OAuth client IDs whose ID tokens are accepted (web, iOS, Android)
GOOGLE_CLIENT_IDS=

PINATA_JWT=
PINATA_GATEWAY=your-gateway.mypinata.cloud
MAX_UPLOAD_MB=50

# Chain: leave CONTRACT_ADDRESS empty to disable the indexer and mint registration
RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=
INDEXER_START_BLOCK=0
INDEXER_CONFIRMATIONS=1

# Domains allowed in Sign-In With Ethereum messages (defaults to CLIENTURL's host)
SIWE_DOMAINS=localhost:3000

# Full tracks (private; served only via signed links) go to this private Supabase Storage
# bucket when SUPABASE_URL and SUPABASE_SERVICE_KEY are set, otherwise to STORAGE_DIR.
# SUPABASE_SERVICE_KEY is the secret / service_role key: never put it in the web app.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=tracks
STORAGE_DIR=./storage
# How browsers reach this API (signed media links point here)
API_PUBLIC_URL=http://localhost:3001
PREVIEW_SECONDS=30
